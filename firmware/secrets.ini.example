; firmware/secrets.ini  (copy of secrets.ini.example — NEVER commit secrets.ini)
; One secret per device, 32+ random characters. Store only its SHA-256 in
; the device_secrets table (see supabase/migrations/20261019121300_device_secrets.sql).
; Leave a line empty to build that device without a secret (old behaviour).

[secrets]
dots1 = -D DEVICE_SECRET=\"replace-with-32-random-characters\"
dots2 =
dots3 =
